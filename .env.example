# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Интеграция с Yclients (читается только на сервере, в браузер не попадает) ---
# Партнёрский токен приложения (Yclients -> Маркетплейс -> Для разработчиков)
YCLIENTS_PARTNER_TOKEN=""
# Пользовательский токен сотрудника с доступом к финансам и записям.
# Либо оставьте пустым и задайте логин/пароль ниже — токен будет получен автоматически.
YCLIENTS_USER_TOKEN=""
YCLIENTS_LOGIN=""
YCLIENTS_PASSWORD=""
# ID филиала в Yclients (число)
YCLIENTS_COMPANY_ID=""
# Необязательно: ручное сопоставление статей Yclients со статьями отчёта, JSON.
# Пример: YCLIENTS_CATEGORY_MAP='{"Аренда офиса":"Аренда","Оплата услуг":"Выручка с услуг"}'
YCLIENTS_CATEGORY_MAP=""
